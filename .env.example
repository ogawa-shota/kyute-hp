# Resendで発行したAPIキー
RESEND_API_KEY=re_xxxxxxxxx

# Resendで認証済みのkyute.jpドメインから送信するアドレス
CONTACT_FROM_EMAIL="KYUTE Website <noreply@kyute.jp>"

# 資料請求後、承認して送る日程調整ページ
MATERIAL_SCHEDULING_URL=https://example.com/schedule

# 資料請求情報を暗号化した承認トークン用（32文字以上）
MATERIAL_APPROVAL_SECRET=replace-with-a-long-random-value

# 任意：Slackで通知・日程調整メールの承認を行う場合
MATERIAL_SLACK_BOT_TOKEN=xoxb-xxxxxxxxx
MATERIAL_SLACK_CHANNEL_ID=C0123456789
MATERIAL_SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
